node_modules
dist
.DS_Store
*.local
dist-ssr

# Generated by scripts/build-content.mjs from content/posts, so the markdown stays the
# single source of truth and a stale checked-in copy can never disagree with it.
src/generated

# Copied out of node_modules at build time so the editor is served from homezai.com
# rather than a third party CDN, pinned by package-lock.json.
public/admin/sveltia-cms.js
public/admin/revisions.js

# Built from src/admin/ by vite.admin.config.js, so the preview the editor runs can
# never disagree with the source it came from or the tests that cover it.
public/admin/preview.js
